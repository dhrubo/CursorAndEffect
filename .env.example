# Optional. The coach uses Grok only when this is set.
# Without it, an Anthropic key is used, and with neither key the coach is scripted.
XAI_API_KEY=
# Optional: override the Grok model used by the chat guide
XAI_MODEL=grok-4.7

# Get a key from https://console.anthropic.com
# Used by the spoken goals conversation. Without it, that conversation stays scripted.
ANTHROPIC_API_KEY=
# Optional: override the Claude model
ANTHROPIC_MODEL=claude-sonnet-4-5
